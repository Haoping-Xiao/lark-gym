      "sheets": {
        "ws_qualification": {
          "title": "Qualification Criteria",
          "values": [
            ["Criterion", "Details", "Notes"],
            [
              "Conversation tagging",
              "Only conversations tagged 'demo-request' are in scope",
              "Other inquiry tags are handled by a different workflow"
            ],
            [
              "Active conversations only",
              "Conversation must be in an open state",
              "Closed/snoozed conversations should not be processed"
            ],
            [
              "No repeat scheduling",
              "Contacts who already have a 'demo-scheduled' tag should be skipped",
              "Also applies to duplicate requests from the same person in different threads"
            ],
            [
              "Competitor domains",
              "nexagen.io, veloxlabs.co, shadowtech.net",
              "Respond to let them know we cannot accommodate the request"
            ],
            [
              "Org size threshold",
              "Minimum 5 employees at the company",
              "Applies to the associated company record"
            ],
            [
              "Contact classification",
              "Must be a registered user, not a lead",
              "Leads without a company association are out of scope"
            ],
            [
              "Decline response",
              "Reply with 'unable to schedule a demo' for disqualified requests",
              "Applies to competitor domains, never-schedule overrides, and other excluded contacts"
            ]
          ]
        },
