{
  "name": "lark-gym",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:cli": "bash scripts/build-cli.sh",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.*",
    "test:go": "cd gyms/lark-cli/cli && go test ./... && go vet ./...",
    "oracle": "node --test tests/harbor.test.mjs",
    "check": "npm run typecheck && npm run format:check && npm test && npm run test:go",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "prettier": "3.9.7",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
